# Supabase (auth/locations/trips — see supabase/schema.sql). The anon key is safe to commit:
# it's visible in every browser network request anyway. Its security comes from Postgres Row
# Level Security policies on each table, not from keeping the key secret. Fill these in from
# Supabase Dashboard > Project Settings > API.
VITE_SUPABASE_URL=https://fyolrfyluvhxtyduyemq.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZ5b2xyZnlsdXZoeHR5ZHV5ZW1xIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODYwODIwOTYsImV4cCI6MjEwMTY1ODA5Nn0.SoL8psa08fFE_exwAzRK7jD4ulSArNU4b7tuVyBTikQ

# Cloudinary (user-uploaded location photos). Same non-secret story as the anon key above: the
# cloud name and upload preset are both visible in every upload request. Safety comes from the
# preset being configured as "Unsigned" with restrictions (max file size, allowed formats) set
# in the Cloudinary dashboard, not from hiding these values. Create an unsigned upload preset at
# Cloudinary Dashboard > Settings > Upload > Upload presets.
VITE_CLOUDINARY_CLOUD_NAME=wxifklf3
VITE_CLOUDINARY_UPLOAD_PRESET=goingroam
