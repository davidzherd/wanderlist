# Copy this file to .env.local (gitignored) and fill in your own key for local dev.
# In CI/production, this is injected from a GitHub Actions secret at build time (see .github/workflows/deploy.yml) —
# note it still ends up in the shipped client bundle since this is a static site with no backend to hide it behind.
VITE_PEXELS_API_KEY=
# CARTO basemap tiles now require an API key (the map shows "API KEY REQUIRED" watermarks without one).
# Get a free key at carto.com and paste it here. Appended to the raster tile URLs as ?key=... in src/components/Map.tsx.
VITE_CARTO_API_KEY=
