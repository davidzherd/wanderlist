# Copy this file to .env.local (gitignored) and fill in your own keys for local dev.
# In production these are set as Vercel project environment variables.

# Server-only (no NEXT_PUBLIC_ prefix): read by app/api/pexels/route.ts, never shipped to the browser.
PEXELS_API_KEY=
# CARTO basemap tiles now require an API key (the map shows "API KEY REQUIRED" watermarks without one).
# Get a free key at carto.com and paste it here. Appended to the raster tile URLs as ?key=... in src/components/Map.tsx.
NEXT_PUBLIC_CARTO_API_KEY=
# Server-only: Google Gemini key for the premium trip assistant (app/api/trip-chat/route.ts).
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional: Gemini model id for the trip assistant (defaults to gemini-3.5-flash; gemini-3.5-flash-lite is faster).
# GEMINI_MODEL=
