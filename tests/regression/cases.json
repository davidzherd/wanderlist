[
  {
    "name": "Registering a new account logs the user in immediately",
    "steps": [
      "Go to /auth",
      "Click Register",
      "Register as a new test user",
      "Go to /"
    ],
    "expected result": "0 locations shown"
  },
  {
    "name": "Login fails with a wrong password and shows an error",
    "steps": [
      "Go to /auth",
      "Register as a new test user",
      "Log out",
      "Go to /auth",
      "Click Sign in",
      "Fill Email = wrongemail@example.com",
      "Fill Password = wrongpassword123",
      "Click Sign in"
    ],
    "expected result": "Invalid login credentials"
  },
  {
    "name": "Login form rejects an invalid email format with client-side validation",
    "steps": [
      "Go to /auth",
      "Click Sign in",
      "Fill Email = notanemail",
      "Fill Password = password123",
      "Click Sign in"
    ],
    "expected result": "Enter a valid email address"
  },
  {
